  27:src/bldc/bldc.c **** 
  28:src/bldc/bldc.c **** void BLDC_OpenLoopDrive(float amp, float freq) {
  29:src/bldc/bldc.c ****       static float phase = 0.0f;
  30:src/bldc/bldc.c ****       float dt = Timer_Read(&dt_timer);
  31:src/bldc/bldc.c ****       Timer_Reset(&dt_timer);
  32:src/bldc/bldc.c **** 
  33:src/bldc/bldc.c ****       float delta_phase = 360.0f * freq * dt;
  34:src/bldc/bldc.c ****       phase += delta_phase;
  35:src/bldc/bldc.c ****       if (phase >= 360.0f) phase -= 360.0f;
  36:src/bldc/bldc.c **** 
  37:src/bldc/bldc.c ****       float u = 0.5f + 0.5f * amp * SinDeg((int)phase);
  38:src/bldc/bldc.c ****       float v = 0.5f + 0.5f * amp * SinDeg((int)phase - 120);
  39:src/bldc/bldc.c ****       float w = 0.5f + 0.5f * amp * SinDeg((int)phase + 120);
  40:src/bldc/bldc.c **** 
  41:src/bldc/bldc.c ****       BLDC_WritePwm(u, v, w);
  42:src/bldc/bldc.c **** }
  43:src/bldc/bldc.c **** 
  44:src/bldc/bldc.c **** /*
