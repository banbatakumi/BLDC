  47:src/bldc/bldc.c **** 
  48:src/bldc/bldc.c **** static inline float BLDC_AdcToRadians(uint16_t adc_value) {
  49:src/bldc/bldc.c ****       // ADCの最大値4095を2πで割る
  50:src/bldc/bldc.c ****       const double conversion_factor = (2.0f * PI) / 4095.0f;
  51:src/bldc/bldc.c **** 
  52:src/bldc/bldc.c ****       // ADC値を制限
  53:src/bldc/bldc.c ****       if (adc_value > 4095) adc_value = 4095;
  54:src/bldc/bldc.c **** 
  55:src/bldc/bldc.c ****       return (float)adc_value * conversion_factor;
  56:src/bldc/bldc.c **** }
